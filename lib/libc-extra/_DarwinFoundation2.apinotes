# _DarwinFoundation2.apinotes -- the clock ids, under the names Swift
# code writes.
#
# <time.h> declares the clock ids as enumerators of clockid_t called
# _CLOCK_REALTIME and so on, and then #defines CLOCK_REALTIME to each.
# Swift imports the macro as a plain Int32 and the enumerator under its
# underscored name, so clock_gettime(CLOCK_REALTIME, &ts) does not
# typecheck: the function wants a clockid_t.
#
# Renaming the enumerators here is what makes the spelling Swift uses
# resolve to the enumerator rather than the macro.  Apple ships a file
# of this name doing exactly this, for the same reason; the mapping is
# a fact about the header.
#
# SwiftVersions pins the pre-Swift-4 spellings, which kept the
# underscore, so code written against those still compiles.
#
# Copyright (c) 2026 Sunneva N. Mariu <sunnevanattsol@gmail.com>
# SPDX-License-Identifier: BSD-3-Clause
Name: _DarwinFoundation2
Enumerators:
- Name: _CLOCK_REALTIME
  SwiftName: CLOCK_REALTIME
- Name: _CLOCK_MONOTONIC
  SwiftName: CLOCK_MONOTONIC
- Name: _CLOCK_MONOTONIC_RAW
  SwiftName: CLOCK_MONOTONIC_RAW
- Name: _CLOCK_MONOTONIC_RAW_APPROX
  SwiftName: CLOCK_MONOTONIC_RAW_APPROX
- Name: _CLOCK_UPTIME_RAW
  SwiftName: CLOCK_UPTIME_RAW
- Name: _CLOCK_UPTIME_RAW_APPROX
  SwiftName: CLOCK_UPTIME_RAW_APPROX
- Name: _CLOCK_PROCESS_CPUTIME_ID
  SwiftName: CLOCK_PROCESS_CPUTIME_ID
- Name: _CLOCK_THREAD_CPUTIME_ID
  SwiftName: CLOCK_THREAD_CPUTIME_ID
SwiftVersions:
- Version: 3
  Enumerators:
  - Name: _CLOCK_REALTIME
    SwiftName: _CLOCK_REALTIME
  - Name: _CLOCK_MONOTONIC
    SwiftName: _CLOCK_MONOTONIC
  - Name: _CLOCK_MONOTONIC_RAW
    SwiftName: _CLOCK_MONOTONIC_RAW
  - Name: _CLOCK_MONOTONIC_RAW_APPROX
    SwiftName: _CLOCK_MONOTONIC_RAW_APPROX
  - Name: _CLOCK_UPTIME_RAW
    SwiftName: _CLOCK_UPTIME_RAW
  - Name: _CLOCK_UPTIME_RAW_APPROX
    SwiftName: _CLOCK_UPTIME_RAW_APPROX
  - Name: _CLOCK_PROCESS_CPUTIME_ID
    SwiftName: _CLOCK_PROCESS_CPUTIME_ID
  - Name: _CLOCK_THREAD_CPUTIME_ID
    SwiftName: _CLOCK_THREAD_CPUTIME_ID
